{
    "manifest_version": 2,
    "name": "Lectio",
    "author": "frutadoconde",
    "version": "2.0",
    "description": "Basic reading accessibility toggle",
    "icons": {
        "48": "icons/icon.svg",
        "96": "icons/icon.svg"
    },
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon.svg",
        "default_title": "Lectio"
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "lectio@frutadoconde.com",
            "update_url": "https://github.com/frutadoconde/lectio/blob/main/updates.json",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "permissions": [
        "<all_urls>",
        "tabs",
        "activeTab",
        "storage"
    ],

    "web_accessible_resources": [
        "fonts/Atkinson_Hyperlegible_Next/AtkinsonHyperlegibleNextVF-Variable.ttf",
        "fonts/Fast/Sans/Fast_Sans_Bold.woff2",
        "fonts/Fast/Sans/Fast_Sans_BoldItalic.woff2",
        "fonts/Fast/Sans/Fast_Sans_Italic.woff2",
        "fonts/Fast/Sans/Fast_Sans_Regular.woff2",
        "fonts/Fast/Serif/Fast_Serif_Bold.woff2",
        "fonts/Fast/Serif/Fast_Serif_BoldItalic.woff2",
        "fonts/Fast/Serif/Fast_Serif_Italic.woff2",
        "fonts/Fast/Serif/Fast_Serif_Regular.woff2",
        "fonts/Focus_Sans/FocusSans_FocusRegular.woff2",
        "fonts/Focus_Sans/FocusSans_Regular.woff2",
        "fonts/Lexend/Lexend-VariableFont_wght.woff2",
        "fonts/Open_Sans/OpenSans-VariableFont_wdth,wght.woff2",
        "fonts/Open_Sans/OpenSans-Italic-VariableFont_wdth,wght.woff2"
    ],
    "content_scripts": [
        {
            "matches":  ["https://*/*"],
            "js": ["jquery-4.0.0.slim.min.js", "content.js"]
        }
    ]
}
